<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Sweet Nails Salonboek</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;1,500&family=Poppins:wght@400;500;600&display=swap">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
:root{
  --paper:#F3E9DC; --card:#FFFAF2; --card-2:#FBF3E7;
  --ink:#2F3127; --ink-2:#5B574B; --muted:#8C8473; --line:#E6D7C3; --line-2:#D9C6AC;
  --terra:#A4432B; --terra-soft:#F4E0D4; --on-terra:#FFF8F0;
  --olive:#6B7440; --sage:#5F8C7C; --gold:#C4912A; --brown:#9A6A3C;
  --ok:#4C7A47; --danger:#B0382B; --danger-soft:#F6DEDA;
  --bar:#D9A48F; --grid:#EADDCB;
  --shadow:0 1px 2px rgba(90,55,25,.06),0 10px 30px rgba(90,55,25,.07);
  --f-display:"Lora",Georgia,"Times New Roman",serif;
  --f-body:"Poppins",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --paper:#1B1612; --card:#251E18; --card-2:#2B231C;
  --ink:#F2E8DA; --ink-2:#CDBFAD; --muted:#9D8F7D; --line:#3A3027; --line-2:#4A3D31;
  --terra:#E48D6C; --terra-soft:#3E2A21; --on-terra:#2A160E;
  --olive:#B3BB82; --sage:#89B7A6; --gold:#E0B456; --brown:#CC9963;
  --ok:#93C38D; --danger:#F08B7D; --danger-soft:#43231F;
  --bar:#7E4A37; --grid:#3A3027;
  --shadow:0 1px 2px rgba(0,0,0,.3);
  color-scheme:dark;
}}
:root[data-theme="dark"]{
  --paper:#1B1612; --card:#251E18; --card-2:#2B231C;
  --ink:#F2E8DA; --ink-2:#CDBFAD; --muted:#9D8F7D; --line:#3A3027; --line-2:#4A3D31;
  --terra:#E48D6C; --terra-soft:#3E2A21; --on-terra:#2A160E;
  --olive:#B3BB82; --sage:#89B7A6; --gold:#E0B456; --brown:#CC9963;
  --ok:#93C38D; --danger:#F08B7D; --danger-soft:#43231F;
  --bar:#7E4A37; --grid:#3A3027;
  --shadow:0 1px 2px rgba(0,0,0,.3);
  color-scheme:dark;
}
*{box-sizing:border-box}
[hidden]{display:none!important}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--f-body);font-size:15px;line-height:1.5;
  background-image:radial-gradient(1200px 500px at 10% -10%,color-mix(in srgb,var(--gold) 10%,transparent),transparent 60%),
  radial-gradient(900px 500px at 110% 110%,color-mix(in srgb,var(--terra) 8%,transparent),transparent 60%);
  background-attachment:fixed;min-height:100%}
img{max-width:100%}
.wrap{max-width:1140px;margin:0 auto;padding-inline:16px;padding-block:18px 120px}
h1,h2,h3{font-family:var(--f-display);font-weight:600;margin:0;text-wrap:balance;color:var(--ink)}
button,input,select,textarea{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:2px solid var(--terra);outline-offset:2px;border-radius:6px}
.num{font-variant-numeric:tabular-nums}
.caps{text-transform:uppercase;letter-spacing:.16em;font-size:11.5px;font-weight:500;color:var(--terra)}

.top{display:flex;flex-direction:column;align-items:center;gap:6px;padding-block:6px 4px}
.logo{width:min(300px,70vw);height:auto;display:block}
.rule{display:flex;align-items:center;gap:12px;color:var(--terra)}
.rule::before,.rule::after{content:"";width:64px;height:1px;background:var(--line-2)}
.kicker{font-family:var(--f-display);letter-spacing:.32em;font-size:15px;color:var(--ink-2);text-transform:uppercase;padding-left:.32em}
.leaf{width:14px;height:14px;flex:none}
.banner{margin:14px auto 0;max-width:720px;border:1px solid var(--line-2);background:var(--card);border-radius:12px;padding:12px 14px;font-size:14px;color:var(--ink-2)}
.banner strong{color:var(--danger)}

.tabs{display:flex;justify-content:center;gap:4px;margin:18px auto 22px;background:var(--card);border:1px solid var(--line);border-radius:999px;padding:4px;width:max-content;max-width:100%}
.tab{border:0;background:transparent;padding:8px 18px;border-radius:999px;color:var(--ink-2);font-weight:500;display:flex;align-items:center;gap:8px}
.tab svg{width:18px;height:18px}
.tab[aria-selected="true"]{background:var(--terra);color:var(--on-terra)}
.botnav{display:none}
@media (max-width:760px){
  .tabs{display:none}
  .botnav{display:grid;grid-template-columns:repeat(4,1fr);position:fixed;left:0;right:0;bottom:0;z-index:30;background:var(--card);border-top:1px solid var(--line);padding:6px 6px calc(6px + env(safe-area-inset-bottom,0px))}
  .botnav .tab{flex-direction:column;gap:2px;font-size:11.5px;padding:6px 4px;border-radius:12px;justify-content:center}
  .botnav .tab[aria-selected="true"]{background:var(--terra-soft);color:var(--terra)}
}

.card{background:var(--card);border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow);padding:20px}
.card + .card{margin-top:16px}
.sec-title{display:flex;align-items:center;gap:10px;font-size:22px}
.muted{color:var(--muted)}
.small{font-size:13px}

.kassa{display:grid;grid-template-columns:minmax(0,1.75fr) minmax(0,1fr);gap:18px;align-items:start}
@media (max-width:980px){.kassa{grid-template-columns:minmax(0,1fr)}}
.who{display:grid;grid-template-columns:minmax(0,1fr) 170px;gap:12px}
@media (max-width:480px){.who{grid-template-columns:minmax(0,1fr)}}
label.f{display:flex;flex-direction:column;gap:5px;font-size:12.5px;color:var(--ink-2);font-weight:500;min-width:0;position:relative}
.inp{width:100%;border:1px solid var(--line-2);background:var(--card-2);border-radius:10px;padding:10px 12px;font-size:15px;min-height:44px}
.inp:focus{border-color:var(--terra);outline:none;box-shadow:0 0 0 3px color-mix(in srgb,var(--terra) 18%,transparent)}
textarea.inp{min-height:64px;resize:vertical}
.sugg{position:absolute;top:100%;left:0;right:0;margin-top:4px;background:var(--card);border:1px solid var(--line-2);border-radius:12px;box-shadow:var(--shadow);z-index:20;overflow:hidden}
.sugg button{display:flex;justify-content:space-between;gap:10px;width:100%;text-align:left;border:0;background:transparent;padding:10px 12px;border-bottom:1px solid var(--line)}
.sugg button:last-child{border-bottom:0}
.sugg button:hover,.sugg button.on{background:var(--terra-soft)}
.hint{font-size:12.5px;color:var(--olive);margin-top:6px;min-height:1em}

.menu{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:26px 34px;margin-top:20px}
.group h3{font-size:22px;display:flex;align-items:center;gap:10px}
.group .caps{display:block;margin:2px 0 8px}
.items{display:flex;flex-direction:column;gap:4px}
.it{display:grid;grid-template-columns:22px minmax(0,1fr) auto;gap:2px 10px;align-items:center;text-align:left;width:100%;border:1px solid transparent;background:transparent;border-radius:10px;padding:8px 10px;min-height:44px}
.it:hover{background:var(--card-2);border-color:var(--line)}
.it .box{width:20px;height:20px;border-radius:6px;border:1.5px solid var(--line-2);display:grid;place-items:center;color:transparent}
.it .nm{display:flex;align-items:baseline;gap:8px;min-width:0;font-size:15.5px}
.it .nm::after{content:"";flex:1;border-bottom:1px dotted var(--line-2);transform:translateY(-4px);min-width:12px}
.it .meta{font-size:12px;color:var(--muted);white-space:nowrap}
.it .pr{color:var(--terra);font-weight:600;font-size:16px}
.it .ds{grid-column:2 / 4;font-size:12.5px;color:var(--ink-2);line-height:1.35}
.it[aria-pressed="true"]{background:var(--terra-soft);border-color:color-mix(in srgb,var(--terra) 35%,transparent)}
.it[aria-pressed="true"] .box{background:var(--terra);border-color:var(--terra);color:var(--on-terra)}
.note{font-size:12.5px;color:var(--ink-2);margin:6px 10px 0}
.extra-row{display:grid;grid-template-columns:minmax(0,1fr) 110px auto;gap:8px;margin-top:8px}
@media (max-width:420px){.extra-row{grid-template-columns:minmax(0,1fr) 90px}.extra-row .btn{grid-column:1 / -1}}

.ticket{position:sticky;top:calc(14px + env(safe-area-inset-top,0px))}
@media (max-width:980px){.ticket{position:static}}
.lines{display:flex;flex-direction:column;margin:12px 0 4px}
.line{display:grid;grid-template-columns:minmax(0,1fr) auto 32px;gap:8px;align-items:center;padding:7px 0;border-bottom:1px dashed var(--line)}
.line .x{border:0;background:transparent;color:var(--muted);width:32px;height:32px;border-radius:8px;font-size:18px;line-height:1}
.line .x:hover{background:var(--danger-soft);color:var(--danger)}
.empty{padding:14px;border:1px dashed var(--line-2);border-radius:12px;color:var(--muted);font-size:13.5px;text-align:center}
.sumrow{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:6px 0}
.sumrow .inp{width:110px;text-align:right;min-height:38px;padding:6px 10px}
.total{display:flex;justify-content:space-between;align-items:baseline;border-top:1px solid var(--line-2);margin-top:6px;padding-top:12px}
.total .v{font-family:var(--f-display);font-size:34px;color:var(--terra);font-weight:600}
.seg{display:grid;grid-template-columns:1fr 1fr;gap:6px;background:var(--card-2);border:1px solid var(--line);border-radius:12px;padding:4px;margin-top:12px}
.seg button{border:0;background:transparent;border-radius:9px;padding:10px;font-weight:500;color:var(--ink-2);min-height:44px}
.seg button[aria-pressed="true"]{background:var(--card);color:var(--ink);box-shadow:0 0 0 1.5px var(--terra)}
.btn{border:1px solid var(--line-2);background:var(--card);border-radius:10px;padding:10px 16px;font-weight:500;min-height:44px;display:inline-flex;align-items:center;justify-content:center;gap:8px}
.btn:hover{border-color:var(--terra)}
.btn.primary{background:var(--terra);border-color:var(--terra);color:var(--on-terra);width:100%;font-size:16px;padding:13px}
.btn.primary:disabled{opacity:.5;cursor:not-allowed}
.btn.ghost{background:transparent}
.btn.sm{min-height:34px;padding:6px 12px;font-size:13.5px}
.btn.danger{color:var(--danger);border-color:color-mix(in srgb,var(--danger) 40%,transparent)}
.editing{display:flex;justify-content:space-between;align-items:center;gap:8px;background:var(--terra-soft);border-radius:10px;padding:8px 12px;font-size:13.5px;margin-bottom:12px}
.stack{display:flex;flex-direction:column;gap:12px}
.today-list .row{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 10px;padding:8px 0;border-bottom:1px solid var(--line)}
.today-list .row:last-child{border-bottom:0}

.float{display:none}
@media (max-width:980px){
  .float:not([hidden]){display:flex;position:fixed;left:12px;right:12px;bottom:calc(76px + env(safe-area-inset-bottom,0px));z-index:25;background:var(--ink);color:var(--paper);border-radius:14px;padding:10px 12px 10px 16px;align-items:center;justify-content:space-between;gap:10px;box-shadow:0 8px 24px rgba(0,0,0,.2)}
  .float button{border:0;background:var(--terra);color:var(--on-terra);border-radius:10px;padding:9px 14px;font-weight:500}
}
@media (min-width:761px) and (max-width:980px){.float:not([hidden]){bottom:16px}}

.monthbar{display:flex;flex-direction:column;gap:10px}
.yearnav{display:flex;align-items:center;gap:8px}
.yearnav .y{font-family:var(--f-display);font-size:24px;min-width:70px;text-align:center}
.icon-btn{border:1px solid var(--line-2);background:var(--card);width:38px;height:38px;border-radius:10px;display:grid;place-items:center}
.months{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:4px}
@media (max-width:760px){.months{grid-template-columns:repeat(6,minmax(0,1fr))}}
.mchip{border:1px solid var(--line);background:var(--card);border-radius:10px;padding:7px 2px;font-size:13px;color:var(--ink-2);position:relative}
.mchip[aria-pressed="true"]{background:var(--terra);color:var(--on-terra);border-color:var(--terra)}
.mchip.has::after{content:"";position:absolute;left:50%;bottom:3px;width:4px;height:4px;margin-left:-2px;border-radius:50%;background:var(--olive)}
.mchip[aria-pressed="true"].has::after{background:var(--on-terra)}
.ovhead{display:flex;justify-content:space-between;align-items:end;gap:12px;flex-wrap:wrap}
.ovhead h2{font-size:28px}
.kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-top:16px}
@media (max-width:860px){.kpis{grid-template-columns:repeat(2,minmax(0,1fr))}}
.kpi{background:var(--card-2);border:1px solid var(--line);border-radius:14px;padding:14px}
.kpi .l{font-size:12.5px;color:var(--ink-2);font-weight:500}
.kpi .v{font-family:var(--f-display);font-size:28px;font-weight:600;line-height:1.2;margin-top:4px}
.kpi .s{font-size:12.5px;color:var(--muted);margin-top:4px}
.kpi.main .v{color:var(--terra)}
.split{height:8px;border-radius:99px;background:var(--line);overflow:hidden;display:flex;gap:2px;margin-top:10px}
.split i{display:block;height:100%}
.split .c{background:var(--olive)}.split .b{background:var(--sage)}
.legend{display:flex;gap:12px;flex-wrap:wrap;font-size:12px;color:var(--ink-2);margin-top:6px}
.legend span{display:inline-flex;align-items:center;gap:5px}
.legend i{width:8px;height:8px;border-radius:2px;display:inline-block}
.two{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:16px;margin-top:16px}
@media (max-width:860px){.two{grid-template-columns:minmax(0,1fr)}}
.two > .card{margin-top:0}
.chart{position:relative;margin-top:10px}
.chart svg{width:100%;height:auto;display:block;overflow:visible}
.tip{position:absolute;pointer-events:none;background:var(--ink);color:var(--paper);font-size:12.5px;border-radius:8px;padding:7px 10px;white-space:nowrap;transform:translate(-50%,-100%);z-index:5}
.pop{display:flex;flex-direction:column;gap:8px;margin-top:10px}
.pop .r{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 10px;align-items:center;font-size:14px}
.pop .bar{grid-column:1 / -1;height:6px;border-radius:99px;background:var(--line)}
.pop .bar i{display:block;height:100%;border-radius:99px;background:var(--bar)}
.day{margin-top:14px}
.day h4{margin:0 0 4px;font-size:13px;font-weight:600;color:var(--ink-2);display:flex;justify-content:space-between}
.day h4 span:first-child::first-letter{text-transform:uppercase}
.vrow{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:4px 12px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line)}
.vrow .who2{font-weight:500}
.vrow .what{font-size:12.5px;color:var(--ink-2);grid-column:1 / 2}
.vrow .amt{font-weight:600;text-align:right}
.vrow .acts{display:flex;gap:6px;grid-column:2 / 4;justify-content:flex-end}
.pill{display:inline-block;font-size:11.5px;font-weight:500;border-radius:99px;padding:2px 9px;border:1px solid}
.pill.cash{color:var(--olive);border-color:color-mix(in srgb,var(--olive) 45%,transparent)}
.pill.bancontact{color:var(--sage);border-color:color-mix(in srgb,var(--sage) 45%,transparent)}
.pill.disc{color:var(--terra);border-color:color-mix(in srgb,var(--terra) 40%,transparent)}
.exports{display:flex;flex-wrap:wrap;gap:8px}

.clist{display:flex;flex-direction:column;margin-top:12px}
.crow{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2px 12px;text-align:left;border:0;border-bottom:1px solid var(--line);background:transparent;padding:12px 6px;border-radius:0}
.crow:hover{background:var(--card-2)}
.crow .n{font-weight:500}
.crow .t{font-weight:600;color:var(--terra);text-align:right}
.crow .m{font-size:12.5px;color:var(--muted)}
.clients-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:16px;align-items:start}
@media (max-width:860px){.clients-grid{grid-template-columns:minmax(0,1fr)}}
.clients-grid > .card{margin-top:0}
.hist .row{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:12px;padding:10px 0;border-bottom:1px solid var(--line);align-items:baseline}
.hist .d{font-size:13px;color:var(--ink-2);white-space:nowrap}

.xform{display:grid;grid-template-columns:150px minmax(0,1fr) 130px;gap:12px}
@media (max-width:640px){.xform{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.xform .desc{grid-column:1 / -1;order:-1}}
.xrow{display:grid;grid-template-columns:90px minmax(0,1fr) auto auto;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line)}
@media (max-width:520px){.xrow{grid-template-columns:minmax(0,1fr) auto}.xrow .d{grid-column:1 / -1;font-size:12.5px}}

.toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--paper);padding:11px 16px;border-radius:12px;font-size:14px;z-index:50;max-width:calc(100% - 32px);box-shadow:0 8px 24px rgba(0,0,0,.2)}
.toast.err{background:var(--danger);color:#fff}
@media (max-width:760px){.toast{bottom:calc(140px + env(safe-area-inset-bottom,0px))}}
.safe{display:flex;gap:14px;align-items:flex-start}
.safe .ico{width:36px;height:36px;border-radius:10px;background:var(--terra-soft);color:var(--terra);display:grid;place-items:center;flex:none}
.foot{text-align:center;margin-top:28px;font-size:12.5px;color:var(--muted);letter-spacing:.06em}
@media (prefers-reduced-motion:no-preference){.it,.tab,.mchip,.btn{transition:background-color .15s,border-color .15s,color .15s}}
</style>
</head>
<body>

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <defs>
    <symbol id="leaf" viewBox="0 0 24 24"><path fill="currentColor" d="M12 1.5l1.6 3.6 2.6-1.3-.5 3.3 3.4-.9-1.2 3 3.3 1.2-3 1.9 1.4 1.4-4.2.6.6 2.6-3.1-1.8L12 22.5l-.9-7.4-3.1 1.8.6-2.6-4.2-.6 1.4-1.4-3-1.9 3.3-1.2-1.2-3 3.4.9-.5-3.3 2.6 1.3z"/></symbol>
  </defs>
</svg>

<div class="wrap">
  <header class="top">
    <img class="logo" src="logo.png" alt="Sweet Nails by Thalyssa">
    <div class="rule"><svg class="leaf"><use href="#leaf"/></svg></div>
    <div class="kicker">Salonboek</div>
  </header>
  <div class="banner" id="banner" hidden></div>

  <nav class="tabs" id="tabs" aria-label="Onderdelen"></nav>

  <!-- KASSA -->
  <section class="view" id="v-kassa">
    <div class="kassa">
      <div>
        <div class="card">
          <div class="who">
            <label class="f" for="client">Naam klant
              <input class="inp" id="client" autocomplete="off" placeholder="Begin te typen…">
              <div class="sugg" id="sugg" hidden></div>
            </label>
            <label class="f" for="vdate">Datum
              <input class="inp" id="vdate" type="date">
            </label>
          </div>
          <div class="hint" id="clientHint"></div>
        </div>
        <div class="card">
          <div class="menu" id="menu"></div>
          <div style="margin-top:22px">
            <h3 class="sec-title" style="font-size:20px"><svg class="leaf" style="color:var(--brown)"><use href="#leaf"/></svg>Ander bedrag</h3>
            <span class="caps" style="display:block;margin-top:2px">Iets dat niet op de prijslijst staat</span>
            <div class="extra-row">
              <input class="inp" id="xDesc" placeholder="Omschrijving, bv. reparatie 1 nagel">
              <input class="inp num" id="xAmt" type="number" inputmode="decimal" step="0.5" min="0" placeholder="€">
              <button class="btn" id="xAdd" type="button">Toevoegen</button>
            </div>
          </div>
        </div>
      </div>

      <aside class="stack" id="ticketCol">
        <div class="card ticket" id="ticket">
          <div class="editing" id="editBar" hidden>
            <span>Je wijzigt een bestaand bezoek</span>
            <button class="btn sm ghost" id="cancelEdit" type="button">Annuleren</button>
          </div>
          <h2 style="font-size:22px">Afrekening</h2>
          <div class="lines" id="lines"></div>
          <div class="sumrow"><span class="muted">Subtotaal</span><span class="num" id="subtotal">€ 0</span></div>
          <div class="sumrow">
            <label for="disc" class="muted">Korting (€)</label>
