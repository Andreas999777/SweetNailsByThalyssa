<script>
(function(){
"use strict";
/* ---------- prijslijst ---------- */
const CATALOG = [
  {id:'builder', title:'Builder Sets', sub:'BIAP · LVL · Hard gel · ± 1u15', leaf:'gold', note:'Removal van je vorige set inbegrepen', items:[
    {id:'b-sn', name:'Short Natural', price:30, label:'Builder · Short Natural'},
    {id:'b-sc', name:'Short Colour', price:35, label:'Builder · Short Colour'},
    {id:'b-ln', name:'Long Natural', price:35, label:'Builder · Long Natural'},
    {id:'b-lc', name:'Long Colour', price:40, label:'Builder · Long Colour'}]},
  {id:'art', title:'Nail Art', sub:'Extra bij je set', leaf:'terra', items:[
    {id:'a-min', name:'Minimalist', price:5, plus:true, desc:'Glitter, flakes of dotjes op 1–2 nagels · < 10 min', label:'Nail art · Minimalist'},
    {id:'a-art', name:'Artsy', price:10, plus:true, desc:'Handgetekende art, blooming gel of glitter op alle nagels · ± 10 min', label:'Nail art · Artsy'},
    {id:'a-glam', name:'Glam', price:15, plus:true, desc:'Chrome of cat eye op alle nagels, met steentjes · ± 20 min', label:'Nail art · Glam'},
    {id:'a-ext', name:'Extravagant', price:20, plus:true, desc:'3D, art op alle nagels, mix van technieken · ± 30 min', label:'Nail art · Extravagant'}]},
  {id:'ext', title:'Extensions', sub:'Hard gel · ± 1u45', leaf:'olive', note:'Removal van je vorige set inbegrepen', items:[
    {id:'e-sn', name:'Short Natural', price:45, label:'Extensions · Short Natural'},
    {id:'e-ln', name:'Long Natural', price:50, label:'Extensions · Long Natural'},
    {id:'e-col', name:'Colour', price:5, plus:true, label:'Extensions · Colour'}]},
  {id:'rem', title:'Removal', sub:'Enkel zonder nieuwe set', leaf:'brown', items:[
    {id:'r-basic', name:'Basic', meta:'short · 40 min', price:20, label:'Removal · Basic'},
    {id:'r-adv', name:'Advanced', meta:'long · 50 min', price:25, label:'Removal · Advanced'},
    {id:'r-pam', name:'Pamper Removal', price:35, desc:'40 min removal + 15 min handmassage', label:'Pamper Removal'}]},
  {id:'mani', title:'Manicure', leaf:'terra', items:[
    {id:'m-basic', name:'Basic Manicure', meta:'20 min', price:10, label:'Basic Manicure'}]},
];
const ITEM = {}; CATALOG.forEach(g=>g.items.forEach(i=>ITEM[i.id]=Object.assign({cat:g.title},i)));
const MONTHS = ['januari','februari','maart','april','mei','juni','juli','augustus','september','oktober','november','december'];
const MSHORT = ['jan','feb','mrt','apr','mei','jun','jul','aug','sep','okt','nov','dec'];
const DAYS = ['zondag','maandag','dinsdag','woensdag','donderdag','vrijdag','zaterdag'];

/* ---------- helpers ---------- */
const $ = id => document.getElementById(id);
const esc = s => String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const pad = n => String(n).padStart(2,'0');
const todayStr = () => { const d=new Date(); return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate()); };
const r2 = n => Math.round((+n||0)*100)/100;
const eur = n => { n=r2(n); const int=Number.isInteger(n); return '€ '+n.toLocaleString('nl-BE',{minimumFractionDigits:int?0:2,maximumFractionDigits:2}); };
const parseAmt = v => { if(v==null) return NaN; const s=String(v).trim().replace(',', '.'); return s===''?NaN:Number(s); };
const ymOf = d => d.slice(0,7);
const ymLabel = ym => MONTHS[+ym.slice(5)-1]+' '+ym.slice(0,4);
const dateNice = d => { const x=new Date(d+'T12:00:00'); return DAYS[x.getDay()]+' '+x.getDate()+' '+MONTHS[x.getMonth()]; };
const dateShort = d => { const x=new Date(d+'T12:00:00'); return x.getDate()+' '+MSHORT[x.getMonth()]+' '+x.getFullYear(); };
const norm = s => String(s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().trim().replace(/\s+/g,' ');
const clientIdOf = name => { let s=norm(name).replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'').slice(0,80); if(!s){ let h=0; for(const c of String(name)) h=(h*31+c.codePointAt(0))>>>0; s='x'+h.toString(36);} return 'c-'+s; };
const newId = p => p+'-'+Date.now().toString(36)+'-'+Math.random().toString(36).slice(2,7);
const leafColor = k => ({gold:'var(--gold)',olive:'var(--olive)',terra:'var(--terra)',brown:'var(--brown)'})[k]||'var(--terra)';
const leaf = k => `<svg class="leaf" style="color:${leafColor(k)}"><use href="#leaf"/></svg>`;
function ls(k,v){ try{ if(v===undefined) return JSON.parse(localStorage.getItem(k)||'null'); if(v===null) localStorage.removeItem(k); else localStorage.setItem(k,JSON.stringify(v)); }catch(e){ return null; } }

let toastT;
function toast(msg,err){ const t=$('toast'); t.textContent=msg; t.className='toast'+(err?' err':''); t.hidden=false; clearTimeout(toastT); toastT=setTimeout(()=>t.hidden=true, err?6000:2600); }

/* ---------- state ---------- */
const now = new Date();
const S = {
  db:null, dl:null, dbState:'loading',
  tab:'kassa', year:now.getFullYear(), ym:now.getFullYear()+'-'+pad(now.getMonth()+1),
  visits:{}, expenses:{}, loaded:new Set(), clients:new Map(), clientsLoaded:false,
  index:[], backupAt:null,
  draft:null, editing:null, openClient:null, epay:'bancontact', busy:false, restore:null,
};
function blankDraft(){ return {date:todayStr(), client:'', items:[], discount:'', pay:'bancontact', note:''}; }
S.draft = Object.assign(blankDraft(), ls('sn-draft')||{});
if(S.draft.date!==todayStr() && !S.draft.items.length && !S.draft.client) S.draft.date=todayStr();

/* ---------- tabs ---------- */
const TABS=[
  {id:'kassa',label:'Kassa',icon:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M7 9h10M7 13h4M7 16h6"/></svg>'},
  {id:'overzicht',label:'Overzicht',icon:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>'},
  {id:'klanten',label:'Klanten',icon:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.5 3.4-5.5 6.5-5.5s5.7 2 6.5 5.5"/><path d="M16 4.5a3.5 3.5 0 010 7M18 14.8c1.8.8 3 2.6 3.5 5.2"/></svg>'},
  {id:'kosten',label:'Kosten',icon:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"/><path d="M9 8h6M9 12h6"/></svg>'},
];
function renderTabs(){
  const html=TABS.map(t=>`<button class="tab" type="button" data-tab="${t.id}" aria-selected="${S.tab===t.id}">${t.icon}<span>${t.label}</span></button>`).join('');
  $('tabs').innerHTML=html; $('botnav').innerHTML=html;
}
function go(tab){
  S.tab=tab; renderTabs();
  TABS.forEach(t=>$('v-'+t.id).hidden = t.id!==tab);
  try{ history.replaceState(null,'','#'+tab); }catch(e){}
  renderAll(); window.scrollTo({top:0});
}
document.addEventListener('click',e=>{ const b=e.target.closest('[data-tab]'); if(b) go(b.dataset.tab); });

/* ---------- KASSA ---------- */
function renderMenu(){
  $('menu').innerHTML = CATALOG.map(g=>`
    <div class="group">
      <h3>${leaf(g.leaf)}${esc(g.title)}</h3>
      ${g.sub?`<span class="caps">${esc(g.sub)}</span>`:'<span class="caps">&nbsp;</span>'}
      <div class="items">
        ${g.items.map(i=>`
          <button type="button" class="it" data-item="${i.id}" aria-pressed="false">
            <span class="box"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><path d="M5 12l5 5 9-10"/></svg></span>
            <span class="nm"><span>${esc(i.name)}</span>${i.meta?`<span class="meta">${esc(i.meta)}</span>`:''}</span>
            <span class="pr num">${i.plus?'+ ':''}${eur(i.price)}</span>
            ${i.desc?`<span class="ds">${esc(i.desc)}</span>`:''}
          </button>`).join('')}
      </div>
      ${g.note?`<div class="note">${esc(g.note)}</div>`:''}
    </div>`).join('');
}
function draftTotals(){
  const sub=r2(S.draft.items.reduce((a,i)=>a+(+i.price||0),0));
  let disc=parseAmt(S.draft.discount); if(!(disc>0)) disc=0; disc=Math.min(disc,sub);
  return {sub, disc:r2(disc), total:r2(sub-disc)};
}
function saveDraft(){ if(!S.editing) ls('sn-draft', S.draft); }
function renderTicket(){
  const d=S.draft;
  document.querySelectorAll('.it').forEach(b=>b.setAttribute('aria-pressed', d.items.some(i=>i.key===b.dataset.item)));
  $('lines').innerHTML = d.items.length ? d.items.map((i,ix)=>`
    <div class="line"><span>${esc(i.label)}</span><span class="num">${eur(i.price)}</span>
    <button class="x" type="button" data-rm="${ix}" aria-label="Verwijder ${esc(i.label)}">×</button></div>`).join('')
    : `<div class="empty">Tik de behandelingen aan op de prijslijst.<br>Ze verschijnen hier en tellen vanzelf op.</div>`;
  const t=draftTotals();
  $('subtotal').textContent=eur(t.sub);
  $('total').textContent=eur(t.total);
  document.querySelectorAll('[data-pay]').forEach(b=>b.setAttribute('aria-pressed', b.dataset.pay===d.pay));
  $('editBar').hidden=!S.editing;
  $('saveVisit').textContent = S.editing?'Wijziging opslaan':'Bezoek opslaan';
  $('saveVisit').disabled = S.busy || S.dbState!=='ok';
  const f=$('float'); f.hidden = S.tab!=='kassa' || !d.items.length;
  $('fCount').textContent = d.items.length+(d.items.length===1?' behandeling':' behandelingen');
  $('fTotal').textContent = eur(t.total);
  renderClientHint();
}
function syncInputs(){
  $('client').value=S.draft.client; $('vdate').value=S.draft.date;
  $('disc').value=S.draft.discount; $('vnote').value=S.draft.note;
}
function renderClientHint(){
  const name=S.draft.client.trim(); const h=$('clientHint');
  if(!name){ h.textContent=''; return; }
  const c=S.clients.get(clientIdOf(name));
  if(c){ const st=clientStats(c); h.textContent=`Vaste klant · ${st.count} ${st.count===1?'bezoek':'bezoeken'} · laatst op ${dateShort(st.last)}`; }
  else h.textContent='Nieuwe klant: wordt automatisch toegevoegd aan je klantenlijst';
}
$('menu').addEventListener('click',e=>{
  const b=e.target.closest('[data-item]'); if(!b) return;
  const it=ITEM[b.dataset.item]; const d=S.draft;
  const ix=d.items.findIndex(i=>i.key===it.id);
  if(ix>=0) d.items.splice(ix,1); else d.items.push({key:it.id, cat:it.cat, label:it.label, price:it.price});
  saveDraft(); renderTicket();
});
$('lines').addEventListener('click',e=>{ const b=e.target.closest('[data-rm]'); if(!b) return; S.draft.items.splice(+b.dataset.rm,1); saveDraft(); renderTicket(); });
$('xAdd').addEventListener('click',()=>{
  const desc=$('xDesc').value.trim(); const amt=parseAmt($('xAmt').value);
  if(!desc||!(amt>=0)||isNaN(amt)){ toast('Vul een omschrijving en een bedrag in.',true); return; }
  S.draft.items.push({key:newId('x'), cat:'Extra', label:desc, price:r2(amt)});
  $('xDesc').value=''; $('xAmt').value=''; saveDraft(); renderTicket();
});
$('vdate').addEventListener('change',e=>{ S.draft.date=e.target.value||todayStr(); saveDraft(); });
$('disc').addEventListener('input',e=>{ S.draft.discount=e.target.value; saveDraft(); renderTicket(); });
$('vnote').addEventListener('input',e=>{ S.draft.note=e.target.value; saveDraft(); });
document.querySelectorAll('[data-pay]').forEach(b=>b.addEventListener('click',()=>{ S.draft.pay=b.dataset.pay; saveDraft(); renderTicket(); }));
$('fGo').addEventListener('click',()=>$('ticket').scrollIntoView({behavior:'smooth',block:'start'}));
$('cancelEdit').addEventListener('click',()=>{ S.editing=null; S.draft=Object.assign(blankDraft(), ls('sn-draft')||{}); syncInputs(); renderTicket(); });

/* klant automatisch aanvullen */
let suggIx=-1;
function suggestions(){
  const q=norm(S.draft.client); if(!q) return [];
  const all=[...S.clients.values()];
  return all.filter(c=>norm(c.name).includes(q)).sort((a,b)=>{
    const as=norm(a.name).startsWith(q)?0:1, bs=norm(b.name).startsWith(q)?0:1; return as-bs || a.name.localeCompare(b.name);
  }).slice(0,6);
}
function renderSugg(){
  const list=suggestions(); const box=$('sugg');
  if(!list.length || (list.length===1 && norm(list[0].name)===norm(S.draft.client))){ box.hidden=true; return; }
  box.innerHTML=list.map((c,i)=>{ const st=clientStats(c); return `<button type="button" data-pick="${esc(c.id)}" class="${i===suggIx?'on':''}"><span>${esc(c.name)}</span><span class="muted small">${st.count}× · ${dateShort(st.last)}</span></button>`; }).join('');
  box.hidden=false;
}
$('client').addEventListener('input',e=>{ S.draft.client=e.target.value; suggIx=-1; saveDraft(); renderSugg(); renderClientHint(); });
$('client').addEventListener('focus',renderSugg);
$('client').addEventListener('blur',()=>setTimeout(()=>$('sugg').hidden=true,150));
$('client').addEventListener('keydown',e=>{
  const list=suggestions(); if($('sugg').hidden||!list.length) return;
  if(e.key==='ArrowDown'){ suggIx=Math.min(list.length-1,suggIx+1); renderSugg(); e.preventDefault(); }
  else if(e.key==='ArrowUp'){ suggIx=Math.max(0,suggIx-1); renderSugg(); e.preventDefault(); }
  else if(e.key==='Enter' && suggIx>=0){ pickClient(list[suggIx].id); e.preventDefault(); }
});
$('sugg').addEventListener('mousedown',e=>e.preventDefault());
$('sugg').addEventListener('click',e=>{ const b=e.target.closest('[data-pick]'); if(b) pickClient(b.dataset.pick); });
function pickClient(id){ const c=S.clients.get(id); if(!c) return; S.draft.client=c.name; $('client').value=c.name; $('sugg').hidden=true; saveDraft(); renderClientHint(); }

function renderToday(){
  const t=todayStr(); const list=(S.visits[ymOf(t)]||[]).filter(v=>v.date===t).sort((a,b)=>(a.createdAt||'')<(b.createdAt||'')?-1:1);
  const box=$('todayList');
  if(S.dbState!=='ok'){ box.innerHTML='<div class="muted small" style="margin-top:6px">Wordt geladen…</div>'; return; }
  if(!list.length){ box.innerHTML='<div class="muted small" style="margin-top:6px">Nog geen bezoeken vandaag. Opgeslagen bezoeken verschijnen hier meteen.</div>'; return; }
  const sum=list.reduce((a,v)=>a+(+v.total||0),0);
  box.innerHTML=list.map(v=>`<div class="row"><span>${esc(v.client)}<br><span class="muted small">${esc(summaryOf(v))}</span></span><span style="text-align:right"><strong class="num">${eur(v.total)}</strong><br><span class="pill ${v.pay}">${v.pay==='cash'?'Cash':'Bancontact'}</span></span></div>`).join('')
    + `<div class="sumrow" style="margin-top:6px"><span class="muted">${list.length} ${list.length===1?'klant':'klanten'}</span><strong class="num">${eur(sum)}</strong></div>`;
}
const summaryOf = v => (v.items||[]).map(i=>i.label).join(' + ');

async function saveVisit(){
  const d=S.draft; const err=$('ticketErr'); err.textContent='';
  const name=d.client.trim();
  if(!name){ err.textContent='Vul de naam van de klant in.'; $('client').focus(); return; }
  if(!d.items.length){ err.textContent='Kies minstens één behandeling.'; return; }
  if(!/^\d{4}-\d{2}-\d{2}$/.test(d.date)){ err.textContent='Kies een geldige datum.'; return; }
  const db=S.db; if(!db) return;
  const cid=clientIdOf(name); const existing=S.clients.get(cid);
  const displayName = existing?existing.name:name;
  const t=draftTotals(); const ym=ymOf(d.date); const ed=S.editing;
  const id = ed?ed.id:newId('v'); const stamp=new Date().toISOString();
  const doc={date:d.date, client:displayName, clientId:cid, items:d.items.map(i=>({key:i.key,cat:i.cat,label:i.label,price:r2(i.price)})),
    subtotal:t.sub, discount:t.disc, total:t.total, pay:d.pay, note:d.note.trim(), createdAt: ed?ed.createdAt:stamp, updatedAt:stamp};
  S.busy=true; renderTicket();
  try{
    await db.doc(`months/${ym}/visits/${id}`).set(doc);
    if(ed && ed.ym!==ym) await db.doc(`months/${ed.ym}/visits/${id}`).delete();
    if(ed && ed.clientId && ed.clientId!==cid) await removeHistory(ed.clientId,id);
    await upsertHistory(cid, displayName, {id, ym, date:d.date, total:t.total, summary:summaryOf(doc), pay:d.pay});
    await ensureIndex(ym);
    toast(ed?'Wijziging opgeslagen':`Opgeslagen: ${displayName} · ${eur(t.total)}`);
    S.editing=null; S.draft=blankDraft(); ls('sn-draft',null); syncInputs();
  }catch(e){
    console.error(e);
    toast(e&&e.code==='quota_exceeded'?'De opslag is vol. Maak een backup en contacteer de beheerder.':'Opslaan is niet gelukt. Controleer je internetverbinding en probeer opnieuw. Wat je invulde blijft staan.',true);
  }finally{ S.busy=false; renderTicket(); }
}
