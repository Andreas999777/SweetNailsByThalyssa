function clientStats(c){
  const h=c.history||[]; let total=0,last='';
  h.forEach(x=>{ total+=+x.total||0; if(x.date>last) last=x.date; });
  return {count:h.length,total:r2(total),last:last||todayStr()};
}
async function upsertHistory(cid,name,entry){
  const ex=S.clients.get(cid); const stamp=new Date().toISOString();
  const history=((ex&&ex.history)||[]).filter(h=>h.id!==entry.id).concat([entry]).sort((a,b)=>a.date<b.date?1:a.date>b.date?-1:0);
  await S.db.doc('clients/'+cid).set({name, history, createdAt:(ex&&ex.createdAt)||stamp, updatedAt:stamp});
}
async function removeHistory(cid,visitId){
  const ex=S.clients.get(cid); if(!ex) return;
  const history=(ex.history||[]).filter(h=>h.id!==visitId);
  if(!history.length) await S.db.doc('clients/'+cid).delete();
  else await S.db.doc('clients/'+cid).set({name:ex.name, history, createdAt:ex.createdAt||'', updatedAt:new Date().toISOString()});
}
async function ensureIndex(ym){
  if(S.index.includes(ym)) return;
  const months=[...new Set(S.index.concat([ym]))].sort();
  await S.db.doc('meta/index').set({months});
}

