function monthStats(ym){
  const vs=S.visits[ym]||[], xs=S.expenses[ym]||[];
  let income=0,cash=0,bank=0,disc=0; const cl=new Set();
  vs.forEach(v=>{ const t=+v.total||0; income+=t; if(v.pay==='cash') cash+=t; else bank+=t; disc+=+v.discount||0; cl.add(v.clientId||norm(v.client)); });
  const costs=xs.reduce((a,x)=>a+(+x.amount||0),0);
  return {income:r2(income),cash:r2(cash),bank:r2(bank),disc:r2(disc),visits:vs.length,clients:cl.size,costs:r2(costs),net:r2(income-costs)};
}
function loadedMonth(ym){ return S.loaded.has('v'+ym) && S.loaded.has('x'+ym); }
