function niceStep(raw){ if(raw<=0) return 50; const p=Math.pow(10,Math.floor(Math.log10(raw))); const n=raw/p; return (n<=1?1:n<=2?2:n<=2.5?2.5:n<=5?5:10)*p; }
function renderChart(){
  const y=S.year; const data=MSHORT.map((m,i)=>{ const ym=y+'-'+pad(i+1); return {ym,m,...monthStats(ym)}; });
  const yearInc=data.reduce((a,d)=>a+d.income,0), yearCost=data.reduce((a,d)=>a+d.costs,0);
  $('chartSub').textContent=`${y}: ${eur(yearInc)} inkomsten · ${eur(yearCost)} kosten · ${eur(yearInc-yearCost)} netto`;
  const W=Math.max(300,Math.round($('chart').clientWidth||600)),H=W<500?180:210,L=40,R=4,T=10,B=24;
  const max=Math.max(...data.map(d=>d.income),0);
  const step = niceStep(max/3); const top = Math.max(step*3, step*Math.ceil(max/step)) || 100;
  const ticks=[]; for(let v=0; v<=top+0.001; v+=step||top) ticks.push(v);
  const bw=(W-L-R)/12, barW=Math.min(30,bw-8);
  const yy=v=>T+(H-T-B)*(1-v/top);
  let s=`<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Inkomsten per maand in ${y}">`;
  ticks.forEach(v=>{ s+=`<line x1="${L}" x2="${W-R}" y1="${yy(v)}" y2="${yy(v)}" stroke="var(--grid)" stroke-width="1"/><text x="${L-6}" y="${yy(v)+4}" text-anchor="end" font-size="11" fill="var(--muted)" font-family="Poppins,sans-serif">${v>=1000?(v/1000).toLocaleString('nl-BE')+'k':v}</text>`; });
  data.forEach((d,i)=>{
    const x=L+i*bw+(bw-barW)/2, h=Math.max(0,yy(0)-yy(d.income)); const sel=d.ym===S.ym;
    const rr=Math.min(4,h/2);
    if(h>0) s+=`<path d="M${x},${yy(0)} V${yy(0)-h+rr} Q${x},${yy(0)-h} ${x+rr},${yy(0)-h} H${x+barW-rr} Q${x+barW},${yy(0)-h} ${x+barW},${yy(0)-h+rr} V${yy(0)} Z" fill="${sel?'var(--terra)':'var(--bar)'}"/>`;
    s+=`<text x="${x+barW/2}" y="${H-6}" text-anchor="middle" font-size="11" fill="${sel?'var(--ink)':'var(--muted)'}" font-weight="${sel?600:400}" font-family="Poppins,sans-serif">${d.m}</text>`;
    s+=`<rect x="${L+i*bw}" y="${T}" width="${bw}" height="${H-T}" fill="transparent" data-bar="${i}" style="cursor:pointer"/>`;
  });
  s+=`<line x1="${L}" x2="${W-R}" y1="${yy(0)}" y2="${yy(0)}" stroke="var(--line-2)" stroke-width="1"/></svg><div class="tip" id="tip" hidden></div>`;
  const box=$('chart'); box.innerHTML=s;
  const tip=$('tip'), svg=box.querySelector('svg');
  const show=(i)=>{ const d=data[i]; const r=svg.getBoundingClientRect();
    const sc=r.width/W; tip.innerHTML=`<strong>${MONTHS[i]}</strong><br>Inkomsten ${eur(d.income)}<br>Kosten ${eur(d.costs)} · Netto ${eur(d.net)}`;
    tip.style.left=Math.min(Math.max((L+i*bw+bw/2)*sc,70),r.width-70)+'px'; tip.style.top=(yy(d.income)*sc-6)+'px'; tip.hidden=false; };
  box.querySelectorAll('[data-bar]').forEach(el=>{
    el.addEventListener('mouseenter',()=>show(+el.dataset.bar));
    el.addEventListener('mouseleave',()=>tip.hidden=true);
    el.addEventListener('click',()=>{ S.ym=data[+el.dataset.bar].ym; renderAll(); });
  });
}
function renderPopular(){
